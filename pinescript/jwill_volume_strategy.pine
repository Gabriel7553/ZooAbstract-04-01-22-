//@version=6
// =============================================================================
// Jwill Volume Strategy — VP, LVN, Ledges, Daily Bias, Setup Grading
// -----------------------------------------------------------------------------
// Encodes the rules in STRATEGY.md. Builds a volume profile over a configurable
// lookback (3D / 7D / 30D / 90D / 180D), classifies bins as HVN / LVN, locates
// Ledges (HVN bin adjacent to an LVN bin), derives HTF bias from MA stack +
// daily-style volume regime, then grades the current setup 0..6 and proposes
// entry / stop / target / R:R.
//
// Footprint absorption/exhaustion is NOT computed (no order flow on retail TV).
// Confirm that manually on the 1m before pulling the trigger.
// =============================================================================

indicator("Jwill Volume Strategy", "JVS", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ===== INPUTS ================================================================
gVP   = "Volume Profile"
mode      = input.string("90D", "Lookback", options=["3D","7D","30D","90D","180D","Custom"], group=gVP)
customD   = input.int(30,   "Custom lookback (days)", minval=1, group=gVP)
nbins     = input.int(60,   "Profile bins", minval=20, maxval=200, group=gVP)
hvnPct    = input.float(0.80, "HVN threshold (% of POC)", minval=0.5, maxval=1.0, step=0.05, group=gVP)
lvnPct    = input.float(0.20, "LVN threshold (% of POC)", minval=0.05, maxval=0.5, step=0.05, group=gVP)
showVP    = input.bool(true,  "Draw profile", group=gVP)
showHVN   = input.bool(true,  "Highlight HVNs (cyan)", group=gVP)
showLVN   = input.bool(true,  "Highlight LVNs (red dotted)", group=gVP)
showLedge = input.bool(true,  "Highlight Ledges (orange)", group=gVP)
profileWidth = input.int(60, "Profile draw width (bars)", minval=10, maxval=200, group=gVP)

gB = "Daily Bias"
maFast = input.int(20, "MA fast",  group=gB)
maSlow = input.int(50, "MA slow",  group=gB)
volAvgLen   = input.int(20,   "Volume average length", group=gB)
volSpikeMul = input.float(1.8, "Volume spike multiplier", step=0.1, group=gB)

gS = "Setup Grading"
atrLen   = input.int(14,   "ATR length", group=gS)
slMult   = input.float(1.0, "Stop = ATR ×", step=0.1, group=gS)
tpMult   = input.float(2.5, "Target = ATR ×", step=0.1, group=gS)
proxMul  = input.float(0.25, "At-level proximity (ATR ×)", step=0.05, group=gS)

// ===== LOOKBACK BARS =========================================================
daysBack = mode == "3D"   ?   3 :
           mode == "7D"   ?   7 :
           mode == "30D"  ?  30 :
           mode == "90D"  ?  90 :
           mode == "180D" ? 180 : customD

tfSec       = timeframe.in_seconds(timeframe.period)
barsPerDay  = tfSec > 0 ? math.max(1, math.floor(86400 / tfSec)) : 1
lookback    = math.min(5000, daysBack * barsPerDay)

// ===== STATE =================================================================
var float[] bins      = array.new_float(nbins, 0.0)
var float[] binPrice  = array.new_float(nbins, 0.0)
var float   topP      = na
var float   botP      = na
var float   pocPrice  = na
var float   pocVol    = na
var float[] ledgePx   = array.new_float()
var float[] lvnPx     = array.new_float()
var float[] hvnPx     = array.new_float()

var box[]  vpBoxes    = array.new_box()
var line[] ledgeLines = array.new_line()
var line[] lvnLines   = array.new_line()
var line[] hvnLines   = array.new_line()

clearBoxes(arr) =>
    while array.size(arr) > 0
        box.delete(array.shift(arr))
clearLines(arr) =>
    while array.size(arr) > 0
        line.delete(array.shift(arr))

// ===== BUILD PROFILE (last bar only — visualization & current state) =========
// ta.highest/ta.lowest must be called every bar (Pine requirement)
_hi = ta.highest(high, lookback)
_lo = ta.lowest(low,  lookback)

if barstate.islast
    array.fill(bins, 0.0)
    array.clear(ledgePx)
    array.clear(lvnPx)
    array.clear(hvnPx)

    hi = _hi
    lo = _lo
    topP := hi
    botP := lo
    range_ = hi - lo
    binSize = range_ / nbins

    if binSize > 0
        for i = 0 to nbins - 1
            array.set(binPrice, i, lo + (i + 0.5) * binSize)

        for i = 0 to lookback - 1
            h = high[i]
            l = low[i]
            v = volume[i]
            if not na(h) and not na(l) and not na(v) and v > 0 and h >= l
                sB = math.max(0, math.min(nbins - 1, math.floor((l - lo) / binSize)))
                eB = math.max(0, math.min(nbins - 1, math.floor((h - lo) / binSize)))
                spread = eB - sB + 1
                per = v / spread
                for b = sB to eB
                    array.set(bins, b, array.get(bins, b) + per)

        pocVol   := array.max(bins)
        pocIdx    = array.indexof(bins, pocVol)
        pocPrice := array.get(binPrice, pocIdx)

        // classify bins
        if pocVol > 0
            for i = 0 to nbins - 1
                ratio = array.get(bins, i) / pocVol
                p = array.get(binPrice, i)
                if ratio >= hvnPct
                    array.push(hvnPx, p)
                if ratio <= lvnPct and ratio > 0.02
                    array.push(lvnPx, p)
            // Ledge: HVN bin with an LVN bin immediately adjacent
            for i = 1 to nbins - 2
                cur = array.get(bins, i)     / pocVol
                up  = array.get(bins, i + 1) / pocVol
                dn  = array.get(bins, i - 1) / pocVol
                if cur >= hvnPct and (up <= lvnPct or dn <= lvnPct)
                    array.push(ledgePx, array.get(binPrice, i))

// ===== DRAW VP ===============================================================
if barstate.islast
    clearBoxes(vpBoxes)
    clearLines(ledgeLines)
    clearLines(lvnLines)
    clearLines(hvnLines)

    if showVP and not na(topP) and not na(pocVol) and pocVol > 0
        binSize = (topP - botP) / nbins
        for i = 0 to nbins - 1
            v = array.get(bins, i)
            if v > 0
                ratio = v / pocVol
                w = math.max(1, math.floor(profileWidth * ratio))
                p = array.get(binPrice, i)
                isPOC = i == array.indexof(bins, pocVol)
                isHVN = ratio >= hvnPct
                isLVN = ratio <= lvnPct
                col = isPOC ? color.new(color.yellow, 0)
                  : isHVN ? color.new(color.aqua,   30)
                  : isLVN ? color.new(color.red,    50)
                  : color.new(color.gray, 75)
                bx = box.new(left=bar_index, top=p + binSize/2,
                     right=bar_index + w, bottom=p - binSize/2,
                     bgcolor=col, border_color=col)
                array.push(vpBoxes, bx)

    leftX  = math.max(0, bar_index - lookback)
    if showLedge
        for i = 0 to array.size(ledgePx) - 1
            p = array.get(ledgePx, i)
            ln = line.new(leftX, p, bar_index, p,
                 color=color.new(color.orange, 0), width=2, extend=extend.right)
            array.push(ledgeLines, ln)
    if showLVN
        for i = 0 to array.size(lvnPx) - 1
            p = array.get(lvnPx, i)
            ln = line.new(leftX, p, bar_index, p,
                 color=color.new(color.red, 60), style=line.style_dotted, extend=extend.right)
            array.push(lvnLines, ln)
    if showHVN
        for i = 0 to array.size(hvnPx) - 1
            p = array.get(hvnPx, i)
            ln = line.new(leftX, p, bar_index, p,
                 color=color.new(color.aqua, 80), style=line.style_dashed, extend=extend.right)
            array.push(hvnLines, ln)

// ===== DAILY-STYLE BIAS ======================================================
ma1 = ta.sma(close, maFast)
ma2 = ta.sma(close, maSlow)
trendUp = close > ma1 and ma1 > ma2
trendDn = close < ma1 and ma1 < ma2

vAvg = ta.sma(volume, volAvgLen)
volSpike = volume > vAvg * volSpikeMul
upBar = close > open
dnBar = close < open
priorRally = ta.rising(close, 3)
priorDrop  = ta.falling(close, 3)
exhaustionTop = volSpike and upBar and priorRally
exhaustionBot = volSpike and dnBar and priorDrop

// healthy trend: price slope same sign, volume slope shrinking
priceSlope = ta.linreg(close,  10, 0) - ta.linreg(close,  10, 1)
volSlope   = ta.linreg(volume, 10, 0) - ta.linreg(volume, 10, 1)
healthyUp  = priceSlope > 0 and volSlope < 0
healthyDn  = priceSlope < 0 and volSlope < 0

bias = trendUp and not exhaustionTop ? 1 : trendDn and not exhaustionBot ? -1 : 0
biasText = bias == 1 ? "BULL" : bias == -1 ? "BEAR" : "NEUTRAL"

// ===== NEAREST LEVEL =========================================================
nearestOf(arr) =>
    bestD = 1e20
    best = float(na)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i)
            d = math.abs(close - p)
            if d < bestD
                bestD := d
                best  := p
    best

nearLVN   = nearestOf(lvnPx)
nearLedge = nearestOf(ledgePx)

atr = ta.atr(atrLen)
proxThresh = atr * proxMul
atLVN   = not na(nearLVN)   and math.abs(close - nearLVN)   <= proxThresh
atLedge = not na(nearLedge) and math.abs(close - nearLedge) <= proxThresh
atLevel = atLVN or atLedge
levelPx = atLedge ? nearLedge : atLVN ? nearLVN : float(na)

// in-HVN check (current price's bin density)
binIdxNow = na(topP) or na(botP) or topP == botP ? na :
     math.max(0, math.min(nbins - 1, math.floor((close - botP) / ((topP - botP) / nbins))))
inHVN = na(binIdxNow) or na(pocVol) or pocVol <= 0 ? false :
     array.get(bins, binIdxNow) / pocVol >= hvnPct

// ===== SETUP & GRADE =========================================================
longSetup  = bias ==  1 and atLevel and not inHVN and not na(levelPx) and levelPx <= close
shortSetup = bias == -1 and atLevel and not inHVN and not na(levelPx) and levelPx >= close

c1 = bias != 0
c2 = atLevel
c3 = longSetup or shortSetup
c4 = not inHVN
c5 = healthyUp or healthyDn or exhaustionTop or exhaustionBot
c6 = (bias ==  1 and ma1 > ma2) or (bias == -1 and ma1 < ma2)

score = (c1?1:0) + (c2?1:0) + (c3?1:0) + (c4?1:0) + (c5?1:0) + (c6?1:0)
grade = score >= 6 ? "A+" : score == 5 ? "A" : score == 4 ? "B+" : score >= 2 ? "B" : "C"

side  = longSetup ? "LONG" : shortSetup ? "SHORT" : "—"
entry = atLevel ? levelPx : close
sl = side == "LONG" ? entry - atr * slMult : side == "SHORT" ? entry + atr * slMult : float(na)
tp = side == "LONG" ? entry + atr * tpMult : side == "SHORT" ? entry - atr * tpMult : float(na)
risk   = side != "—" ? math.abs(entry - sl) : float(na)
reward = side != "—" ? math.abs(tp - entry) : float(na)
rr     = not na(risk) and risk > 0 ? reward / risk : float(na)
points = reward

// ===== DASHBOARD =============================================================
var table dash = table.new(position.top_right, 2, 13,
     bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)

f_color_bias() => bias ==  1 ? color.lime : bias == -1 ? color.red : color.yellow
f_color_side() => side == "LONG" ? color.lime : side == "SHORT" ? color.red : color.gray
f_color_grade() => score >= 6 ? color.lime : score >= 5 ? color.aqua : score >= 4 ? color.yellow : color.gray
f_fmt(x) => na(x) ? "—" : str.tostring(x, format.mintick)

if barstate.islast
    table.cell(dash, 0,  0, "Bias",   text_color=color.white, bgcolor=color.new(color.gray,40))
    table.cell(dash, 1,  0, biasText, text_color=f_color_bias(), bgcolor=color.new(color.gray,60))
    table.cell(dash, 0,  1, "Setup",  text_color=color.white)
    table.cell(dash, 1,  1, side,     text_color=f_color_side())
    table.cell(dash, 0,  2, "Grade",  text_color=color.white)
    table.cell(dash, 1,  2, grade + " (" + str.tostring(score) + "/6)", text_color=f_color_grade())
    table.cell(dash, 0,  3, "@Level", text_color=color.white)
    table.cell(dash, 1,  3, atLedge ? "Ledge" : atLVN ? "LVN" : inHVN ? "HVN(avoid)" : "none",
                          text_color=atLedge or atLVN ? color.lime : inHVN ? color.red : color.gray)
    table.cell(dash, 0,  4, "Entry",  text_color=color.white)
    table.cell(dash, 1,  4, f_fmt(entry))
    table.cell(dash, 0,  5, "Stop",   text_color=color.white)
    table.cell(dash, 1,  5, f_fmt(sl), text_color=color.red)
    table.cell(dash, 0,  6, "Target", text_color=color.white)
    table.cell(dash, 1,  6, f_fmt(tp), text_color=color.lime)
    table.cell(dash, 0,  7, "Points", text_color=color.white)
    table.cell(dash, 1,  7, f_fmt(points))
    table.cell(dash, 0,  8, "R:R",    text_color=color.white)
    table.cell(dash, 1,  8, na(rr) ? "—" : str.tostring(rr, "#.##"))
    table.cell(dash, 0,  9, "Trend",  text_color=color.white)
    table.cell(dash, 1,  9, trendUp ? "UP" : trendDn ? "DOWN" : "flat",
                          text_color=trendUp ? color.lime : trendDn ? color.red : color.yellow)
    table.cell(dash, 0, 10, "Vol",    text_color=color.white)
    table.cell(dash, 1, 10, exhaustionTop ? "EXH TOP" :
                            exhaustionBot ? "EXH BOT" :
                            healthyUp     ? "healthy↑" :
                            healthyDn     ? "healthy↓" : "normal",
                          text_color=exhaustionTop or exhaustionBot ? color.orange : color.gray)
    table.cell(dash, 0, 11, "POC",    text_color=color.white)
    table.cell(dash, 1, 11, f_fmt(pocPrice), text_color=color.yellow)
    table.cell(dash, 0, 12, "Lookback", text_color=color.white)
    table.cell(dash, 1, 12, str.tostring(daysBack) + "d / " + str.tostring(lookback) + "b")

// ===== ALERTS ================================================================
alertcondition(longSetup  and grade == "A+", "A+ Long",  "JVS A+ Long setup at level")
alertcondition(shortSetup and grade == "A+", "A+ Short", "JVS A+ Short setup at level")
alertcondition(longSetup  and (grade == "A" or grade == "A+"),  "A/A+ Long",  "JVS A/A+ Long setup")
alertcondition(shortSetup and (grade == "A" or grade == "A+"),  "A/A+ Short", "JVS A/A+ Short setup")
alertcondition(exhaustionTop, "Exhaustion Top", "JVS volume-spike exhaustion top")
alertcondition(exhaustionBot, "Exhaustion Bot", "JVS volume-spike exhaustion bottom")

// ===== PLOT TRADE LEVELS WHEN ACTIVE =========================================
plot(side != "—" ? entry : na, "Entry",  color=color.new(color.white, 0), style=plot.style_circles, linewidth=2)
plot(side != "—" ? sl    : na, "Stop",   color=color.new(color.red,   0), style=plot.style_circles, linewidth=2)
plot(side != "—" ? tp    : na, "Target", color=color.new(color.lime,  0), style=plot.style_circles, linewidth=2)
plot(ma1, "MA fast", color=color.new(color.yellow, 60))
plot(ma2, "MA slow", color=color.new(color.orange, 60))
